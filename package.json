{
  "name": "b3pay-net",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/modules/sync.mjs && astro dev",
    "build": "node scripts/preflight.mjs && node scripts/modules/sync.mjs && astro build",
    "preview": "node scripts/serve-dist.mjs 4180 dist",
    "modules:sync": "node scripts/modules/sync.mjs",
    "module:build": "node scripts/modules/build-module.mjs",
    "typecheck": "node scripts/modules/sync.mjs && astro check && tsc -p tsconfig.api.json --noEmit",
    "check:links": "node scripts/check-links.mjs dist",
    "check:redirects": "node scripts/check-redirects.mjs dist",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "brand:images": "node scripts/generate-brand-images.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.8",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "astro": "^7.4.4",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "resend": "^4.8.0",
    "starlight-links-validator": "^0.27.0",
    "starlight-sidebar-topics": "^0.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.10.0",
    "@vercel/node": "^5.9.5",
    "@vercel/routing-utils": "^6.6.0",
    "typescript": "^6.0.3"
  }
}

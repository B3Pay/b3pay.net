{
  "$schema": "../../public/schemas/b3pay-module.schema.json",
  "schema": 1,
  "id": "meant",
  "title": "Meant",
  "description": "The meaning layer for contract calls: Candid interfaces compiled into a canonical, identity-addressed graph, and profiles that say what each value means and what each call does.",
  "group": "internet-computer",
  "status": "maintained",
  "links": {
    "repository": "https://github.com/B3Pay/Meant",
    "package": "https://crates.io/crates/meant"
  },
  "home": "index.html",
  "source": {
    "static": {
      "command": ["node", "website/build.mjs", "--out", "{out}"],
      "edits": [
        {
          "file": "website/content/_site.json",
          "replace": [
            { "pointer": "/url", "from": "https://ic-reactor.b3pay.net/candid-core/", "to": "https://b3pay.net/docs/meant/" },
            { "pointer": "/docs/title", "from": "All libraries", "to": "All docs" },
            { "pointer": "/docs/url", "from": "https://ic-reactor.b3pay.net/v4/", "to": "/docs/" },
            { "pointer": "/footer/links/0/label", "from": "All libraries", "to": "All docs" },
            { "pointer": "/footer/links/0/href", "from": "https://ic-reactor.b3pay.net/v4/", "to": "/docs/" }
          ]
        }
      ]
    }
  }
}

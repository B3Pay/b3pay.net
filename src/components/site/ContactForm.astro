---
/**
 * The contact form, posted to api/contact.ts. The Clear Signing page uses it
 * as its intake form, with the topic set and the contracts field first.
 *
 * TOPICS must match the list in api/contact.ts; scripts/contact-form.test.mjs
 * fails when they differ.
 */
interface Props {
  /** Key of the topic selected when the page opens; `?topic=<key>` overrides it. */
  topic?: string;
  /** Lead with the contracts field (the Clear Signing intake). */
  intake?: boolean;
}

const TOPICS = [
  { key: "clear-signing", label: "Clear Signing descriptors" },
  { key: "toolkit", label: "Toolkit or MCP server" },
  { key: "b3forge", label: "B3Forge" },
  { key: "internet-computer", label: "Internet Computer products" },
  { key: "other", label: "Something else" },
];

const { topic = "clear-signing", intake = false } = Astro.props;
const id = intake ? "intake" : "contact";
---

<form class="contact-form not-content" data-contact-form method="post" action="/api/contact/" id={id}>
  <div class="row">
    <label>
      <span>Your name</span>
      <input name="name" autocomplete="name" required maxlength="120" />
    </label>
    <label>
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required maxlength="200" />
    </label>
  </div>
  <div class="row">
    <label>
      <span>Protocol or company <em>(optional)</em></span>
      <input name="organization" autocomplete="organization" maxlength="120" />
    </label>
    <label>
      <span>Topic</span>
      <select name="topic">
        {
          TOPICS.map((t) => (
            <option value={t.label} data-key={t.key} selected={t.key === topic}>
              {t.label}
            </option>
          ))
        }
      </select>
    </label>
  </div>
  <label>
    <span>Contracts <em>(optional: chain and address, one per line)</em></span>
    <textarea name="contracts" rows={intake ? 4 : 2} maxlength="2000" placeholder="Ethereum 0x…&#10;Base 0x…"></textarea>
  </label>
  <label>
    <span>Message</span>
    <textarea
      name="message"
      rows="5"
      required
      minlength="10"
      maxlength="5000"
      placeholder={intake ? "Which functions your users sign, and anything we should know: proxies, upgrades, deadlines." : ""}
    ></textarea>
  </label>
  {/* A person never fills this: it is off-screen, unfocusable and hidden from assistive technology. */}
  <div class="trap" aria-hidden="true">
    <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <p class="note">
    Public addresses are all we need. Never send a private key, seed phrase or other secret, here or anywhere else.
  </p>
  <div class="actions">
    <button type="submit">Send</button>
    <p class="status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-contact-form]")) {
    const status = form.querySelector<HTMLElement>(".status")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

    // `?topic=<key>` picks the topic, so a page can link to the form for its subject.
    const wanted = new URLSearchParams(location.search).get("topic");
    const option = wanted && form.querySelector<HTMLOptionElement>(`option[data-key="${CSS.escape(wanted)}"]`);
    if (option) option.selected = true;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      button.disabled = true;
      status.dataset.state = "sending";
      status.textContent = "Sending…";
      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.error ?? `The message was not sent (HTTP ${response.status}).`);
        form.reset();
        status.dataset.state = "sent";
        status.textContent = "Sent. We reply by email.";
      } catch (error) {
        status.dataset.state = "error";
        status.textContent = `${error instanceof Error ? error.message : "The message was not sent."} You can also write to us on GitHub.`;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-form {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    margin-block: 1.5rem;
  }
  .row {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  label {
    display: grid;
    gap: 0.35rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-white);
  }
  label em {
    font-style: normal;
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    color: var(--sl-color-white);
    font: inherit;
    font-weight: 400;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }
  textarea {
    resize: vertical;
  }
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .note {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  button {
    padding: 0.65rem 1.5rem;
    border: 0;
    border-radius: var(--radius-md);
    background-color: var(--brand);
    color: var(--on-brand);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  button:hover {
    background-color: var(--brand-hover);
  }
  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .status {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .status[data-state="sent"] {
    color: var(--sl-color-green-high);
  }
  .status[data-state="error"] {
    color: var(--danger);
  }
</style>

---
/**
 * FIG. 02: one descriptor, two readers. The hero's call as a wallet shows it,
 * and as an agent would work through it with the toolkit, which is in
 * development: simulate, decode, clear-sign, then wait for a person. The
 * wires draw and the agent's checks tick as the section scrolls in, where
 * the browser can tie an animation to scrolling; elsewhere they are drawn.
 */
import Section from "./Section.astro";
import Status from "./Status.astro";
import { HERO } from "./calldata";

const [intent, ...fields] = HERO.readable;

const CHECKS = [
  { name: "Simulate", text: "against current chain state" },
  { name: "Decode", text: "with the contract's verified ABI" },
  { name: "Clear-sign", text: "with this descriptor" },
];
---

<Section
  id="readers"
  fig="FIG. 02"
  eyebrow="One descriptor, two readers"
  title="Written once, read by a wallet and by an agent"
>
  <Fragment slot="lead">
    <p>
      The descriptor we write so a wallet can show a person what a call does is the file our toolkit, now in
      development, turns into an agent's tool for that call, with the same readable text as its consent message. An
      agent working through it can only propose calls the descriptor explains, and a person reads each one before it is
      signed.
    </p>
  </Fragment>

  <div class="readers" aria-hidden="true" data-pagefind-ignore>
    <div class="source rise">
      <span class="braces">{"{ }"}</span>
      <span>
        <span class="source-name">One descriptor</span>
        <code>approve(address spender,uint256 value)</code>
      </span>
    </div>

    <div class="wires">
      <span class="stem"></span>
      <span class="bar"></span>
      <span class="drop left"></span>
      <span class="drop right"></span>
    </div>

    <div class="cards">
      <div class="reader rise">
        <div class="reader-head">
          <span class="who">In a wallet</span>
          <Status state="done">Clear-signed</Status>
        </div>
        <p class="intent">{intent.value}</p>
        <dl>
          {
            fields.map((field) => (
              <div>
                <dt>{field.label}</dt>
                <dd>
                  {field.value}
                  {"detail" in field && <span class="detail">{field.detail}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="confirm">
          <span>Reject</span>
          <span class="primary">Approve</span>
        </div>
      </div>

      <div class="reader agent rise">
        <div class="reader-head">
          <span class="who">Through an agent</span>
          <Status state="drafting">In development</Status>
        </div>
        <p class="proposal">The agent proposes <strong>{intent.value}</strong></p>
        <ol class="checks">
          {
            CHECKS.map((check, i) => (
              <li style={`--n: ${i}`}>
                <span class="tick">
                  <svg viewBox="0 0 12 12">
                    <path d="M2.5 6.2 5 8.6l4.5-5.2" />
                  </svg>
                </span>
                <strong>{check.name}</strong>
                <span class="what">{check.text}</span>
              </li>
            ))
          }
          <li class="you">
            <span class="ring"></span>
            <strong>Confirm</strong>
            <span class="what">Waiting for you</span>
          </li>
        </ol>
      </div>
    </div>
  </div>

  <p class="sr-only">
    The same descriptor, read twice. A wallet shows the call as Approve USDC, spender Permit2, amount Unlimited USDC,
    with Reject and Approve. Through an agent, with our toolkit once it is built, the call is simulated against current
    chain state, decoded with the contract's verified ABI and clear-signed with the descriptor, then waits for a person
    to confirm it.
  </p>
  <p class="more rise">
    Nothing is signed until a person approves that one transaction. <a href="/toolkit/">What the toolkit will do</a>
  </p>
</Section>

<style>
  .readers {
    margin-top: 3rem;
  }

  /* ── The descriptor both cards read ──────────────────────────────── */

  .source {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--brand);
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    box-shadow: 0 18px 50px -30px color-mix(in srgb, var(--brand) 60%, transparent);
  }

  .braces {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background-color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }

  .source > span:last-child {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .source-name {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .source code {
    overflow-wrap: anywhere;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink);
  }

  /* ── Wires from the descriptor to each card ──────────────────────── */

  .wires {
    position: relative;
    height: 3.5rem;
  }

  .wires span {
    position: absolute;
    background-color: var(--brand);
  }

  .stem {
    top: 0;
    left: calc(50% - 0.5px);
    width: 1px;
    height: 50%;
    transform-origin: top;
  }

  .bar {
    top: 50%;
    left: 25%;
    width: 50%;
    height: 1px;
  }

  .drop {
    top: 50%;
    width: 1px;
    height: 50%;
    transform-origin: top;
  }

  .drop.left {
    left: calc(25% - 0.5px);
  }

  .drop.right {
    left: calc(75% - 0.5px);
  }

  /* One column: one wire, straight down. */
  @media (max-width: 47.99rem) {
    .wires {
      height: 2rem;
    }
    .stem {
      height: 100%;
    }
    .bar,
    .drop {
      display: none;
    }
  }

  /* ── The two readers ─────────────────────────────────────────────── */

  .cards {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .reader {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
  }

  .reader-head {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .who {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .intent {
    margin: 1.1rem 0 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  dl {
    display: grid;
    gap: 0.6rem;
    margin: 1rem 0 1.4rem;
  }

  dl div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
  }

  dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6rem;
    align-items: baseline;
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }

  .detail {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink-muted);
  }

  .confirm {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: auto;
  }

  .confirm span {
    display: grid;
    place-items: center;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ink);
  }

  .confirm .primary {
    border-color: var(--brand);
    background-color: var(--brand);
    color: var(--on-brand);
  }

  .proposal {
    margin: 1.1rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--ink-muted);
  }

  .proposal strong {
    display: block;
    margin-top: 0.2rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .checks {
    display: grid;
    gap: 0.7rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    display: grid;
    grid-template-columns: 1.25rem auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: center;
    font-size: var(--sl-text-sm);
    color: var(--ink);
  }

  .what {
    color: var(--ink-muted);
  }

  .tick {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background-color: var(--brand);
    color: var(--on-brand);
  }

  .tick svg {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Waiting for a person: an amber ring around an amber dot, the design system's needs-you. */
  .ring {
    justify-self: center;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background-color: var(--brand);
    box-shadow:
      0 0 0 3px var(--surface-raised),
      0 0 0 4px var(--brand);
  }

  /* Boxed, with the ring still under the ticks. */
  .you {
    margin: 0.3rem -0.65rem 0;
    padding: 0.65rem;
    border: 1px solid var(--brand);
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, var(--brand-soft) 45%, transparent);
  }

  .you .what {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  .more {
    margin: 2rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  .more a {
    margin-inline-start: 0.4rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }

  .more a::after {
    content: " →";
  }

  /* Drawn and ticked by scrolling, where the browser can tie an animation to
     it. The timelines are in rules of their own (see site.css). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stem,
      .drop {
        animation: home-grow-down linear both;
      }
      .bar {
        animation: home-grow-out linear both;
      }
      .tick {
        animation: home-tick linear both;
      }
      .ring {
        animation: home-waiting linear both;
      }
      .readers :is(.stem, .drop, .bar, .tick, .ring) {
        animation-timeline: view();
      }
      .readers .stem {
        animation-range: cover 12% cover 26%;
      }
      .readers .bar {
        animation-range: cover 24% cover 32%;
      }
      .readers .drop {
        animation-range: cover 30% cover 40%;
      }
      .readers .tick {
        animation-range: cover calc(28% + var(--n) * 7%) cover calc(31% + var(--n) * 7%);
      }
      .readers .ring {
        animation-range: cover 50% cover 58%;
      }
    }
  }

  @keyframes home-grow-down {
    from {
      scale: 1 0;
    }
  }

  @keyframes home-grow-out {
    from {
      scale: 0 1;
    }
  }

  @keyframes home-tick {
    from {
      background-color: transparent;
      box-shadow: inset 0 0 0 1.5px var(--ink-muted);
      color: transparent;
    }
  }

  @keyframes home-waiting {
    from {
      box-shadow:
        0 0 0 3px var(--surface-raised),
        0 0 0 4px var(--brand),
        0 0 0 4px color-mix(in srgb, var(--brand) 50%, transparent);
    }
    to {
      box-shadow:
        0 0 0 3px var(--surface-raised),
        0 0 0 4px var(--brand),
        0 0 0 12px transparent;
    }
  }
</style>

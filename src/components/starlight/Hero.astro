---
/**
 * Starlight's hero on every splash page except two, which have their own:
 * the home page, a signature request that decodes itself from calldata into
 * what a person reads (../home/HomeHero.astro), and the Clear Signing
 * coverage tracker, its headline numbers worked out from its report
 * (../coverage/CoverageHero.astro). All of them read the page's `hero`
 * frontmatter for the title, tagline and actions.
 */
import Default from "@astrojs/starlight/components/Hero.astro";
import CoverageHero from "../coverage/CoverageHero.astro";
import HomeHero from "../home/HomeHero.astro";

// Starlight gives a page the id of its path under src/content/docs, and the
// home page (src/content/docs/index.mdx) the id "".
const { id } = Astro.locals.starlightRoute;
---

{id === "" ? <HomeHero /> : id === "clear-signing/coverage" ? <CoverageHero /> : <Default />}

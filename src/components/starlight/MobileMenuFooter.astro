---
/**
 * The bottom of Starlight's mobile sidebar menu: the site's sections, which
 * the header shows only on wider screens, then Starlight's own controls.
 */
import Default from "@astrojs/starlight/components/MobileMenuFooter.astro";
import { MOBILE, isCurrent } from "../site/nav";

const pathname = Astro.url.pathname;
---

<nav class="site-sections" aria-label="Site">
  <ul>
    {
      MOBILE.map((link) => (
        <li>
          <a href={link.href} aria-current={isCurrent(pathname, link.href) ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<Default />

<style>
  .site-sections {
    border-top: 1px solid var(--sl-color-gray-6);
    padding-block: 0.75rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  a {
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  a[aria-current="page"] {
    color: var(--sl-color-text-accent);
  }
</style>

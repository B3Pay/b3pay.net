---
/**
 * FIG. 02: the leaderboard, one row per protocol, busiest first. A row opens
 * to its contracts (./ContractCard.astro).
 *
 * It is a table that works without scripts: every row is open and nothing is
 * filtered. With scripts, the rows start folded and the filters, the search
 * and the sortable headings appear; the inline script below does that before
 * the table is drawn, so nothing jumps, and puts everything back if the board's
 * script has not taken over within three seconds. Below 64rem the rows are
 * cards, each cell with its heading beside it.
 */
import Section from "../home/Section.astro";
import ContractCard from "./ContractCard.astro";
import Meter from "./Meter.astro";
import StatusBadge from "./StatusBadge.astro";
import StatusIcon from "./StatusIcon.astro";
import { chainName, chainTag, chains, chainsOf, count, host, perDay, percent, plural, report } from "./report.ts";
import type { CoverageStatus } from "./types.ts";

interface Props {
  id: string;
}

const { id } = Astro.props;
const { protocols, categories } = report;

const ORDER: Record<CoverageStatus, number> = { covered: 0, partial: 1, uncovered: 2 };

const rows = protocols.map((protocol, i) => {
  const { totals } = protocol;
  const contracts = [...protocol.contracts].sort(
    (a, b) => (b.sample?.perDay ?? 0) - (a.sample?.perDay ?? 0) || ORDER[a.status] - ORDER[b.status],
  );
  const search = [
    protocol.name,
    protocol.categoryLabel,
    ...protocol.contracts.flatMap((contract) => [contract.label, contract.name, contract.address]),
  ]
    .join(" ")
    .toLowerCase();
  return {
    protocol,
    totals,
    rank: i + 1,
    contracts,
    marks: [...protocol.contracts].sort((a, b) => ORDER[a.status] - ORDER[b.status]).map((contract) => contract.status),
    chainIds: chainsOf(protocol),
    search,
  };
});

const COLUMNS = 8;
---

<Section {id} fig="FIG. 02" eyebrow="Protocols" title="Every protocol we track, busiest first">
  <Fragment slot="lead">
    <p>
      {plural(protocols.length, "protocol")}, by their contracts' recent transactions a day. Open one for its contracts:
      what the registry formats, what people called, and where B3Pay has a draft, how one real call reads with it.
    </p>
  </Fragment>

  <div class="board" data-board>
    <script is:inline>
      // Runs as the board is parsed: with scripts on, the rows start folded
      // and the filters show, before anything is drawn. If the board's script
      // has not taken over within three seconds, every row opens again.
      (() => {
        const board = document.currentScript.parentElement;
        board.dataset.js = "";
        setTimeout(() => board.hasAttribute("data-ready") || delete board.dataset.js, 3000);
      })();
    </script>

    <form class="toolbar" role="search" aria-label="Filter the protocols">
      <label class="field search">
        <span class="field-label">Search</span>
        <input type="search" name="q" placeholder="Protocol, contract or address" autocomplete="off" spellcheck="false" />
      </label>
      <label class="field">
        <span class="field-label">Chain</span>
        <select name="chain">
          <option value="">All chains</option>
          {chains.map((chain) => <option value={chain.id}>{chain.name}</option>)}
        </select>
      </label>
      <label class="field">
        <span class="field-label">Category</span>
        <select name="category">
          <option value="">All categories</option>
          {Object.entries(categories).map(([key, category]) => <option value={key}>{category.label}</option>)}
        </select>
      </label>
      <label class="field">
        <span class="field-label">Status</span>
        <select name="status">
          <option value="">All statuses</option>
          <option value="covered">Covered</option>
          <option value="partial">Partial</option>
          <option value="uncovered">Uncovered</option>
          <option value="draft">Draft ready</option>
        </select>
      </label>
      <div class="tally">
        <p class="shown" aria-live="polite" data-shown>All {plural(protocols.length, "protocol")}</p>
        <button type="reset" class="reset">Clear filters</button>
      </div>
    </form>

    <div class="frame">
      <table>
        <caption class="sr-only">
          The protocols the tracker follows, with how many of their contracts have a descriptor and how much of their
          recent traffic a wallet could clear-sign. Each protocol's contracts follow its row.
        </caption>
        <thead>
          <tr>
            <th scope="col" class="rank">
              <span aria-hidden="true">#</span>
              <span class="sr-only">Rank by transactions a day</span>
            </th>
            <th scope="col" class="protocol" data-sort="name">
              <button type="button" class="sort" disabled>
                Protocol
                <span class="arrow" aria-hidden="true"></span>
              </button>
            </th>
            <th scope="col">Category</th>
            <th scope="col">Chains</th>
            <th scope="col">Status</th>
            <th scope="col" data-sort="covered">
              <button type="button" class="sort" disabled>
                Contracts covered
                <span class="arrow" aria-hidden="true"></span>
              </button>
            </th>
            <th scope="col" data-sort="share">
              <button type="button" class="sort" disabled>
                <span>
                  Clear-signable{" "}
                  <span class="sub">of recent transactions</span>
                </span>
                <span class="arrow" aria-hidden="true"></span>
              </button>
            </th>
            <th scope="col" class="num" data-sort="perDay" aria-sort="descending">
              <button type="button" class="sort" disabled>
                <span>
                  Transactions{" "}
                  <span class="sub">a day</span>
                </span>
                <span class="arrow" aria-hidden="true"></span>
              </button>
            </th>
          </tr>
        </thead>

        {
          rows.map(({ protocol, totals, rank, contracts, marks, chainIds, search }) => (
            <tbody
              id={`protocol-${protocol.id}`}
              class="group"
              data-protocol
              data-rank={rank}
              data-name={protocol.name.toLowerCase()}
              data-chains={chainIds.join(" ")}
              data-category={protocol.category}
              data-status={protocol.status}
              data-draft={totals.drafts > 0 ? "" : undefined}
              data-covered={totals.contracts ? totals.covered / totals.contracts : 0}
              data-share={totals.txShareCovered ?? ""}
              data-per-day={totals.perDay}
              data-search={search}
            >
              <tr class="summary">
                <td class="rank" data-label="#">
                  {String(rank).padStart(2, "0")}
                </td>
                <th scope="row" class="protocol">
                  <button
                    type="button"
                    class="toggle"
                    aria-expanded="true"
                    aria-controls={`protocol-${protocol.id}-contracts`}
                    disabled
                  >
                    <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="m5.5 3.5 5 4.5-5 4.5" />
                    </svg>
                    <span class="name">{protocol.name}</span>
                  </button>
                </th>
                <td class="category" data-label="Category">
                  {protocol.categoryLabel}
                </td>
                <td class="chains" data-label="Chains">
                  <ul class="tags">
                    {chainIds.map((chainId) => (
                      <li>
                        <span aria-hidden="true">{chainTag(chainId)}</span>
                        <span class="sr-only">{chainName(chainId)}</span>
                      </li>
                    ))}
                  </ul>
                </td>
                <td class="status" data-label="Status">
                  <span class="badges">
                    <StatusBadge kind={protocol.status} />
                    {totals.drafts > 0 && <StatusBadge kind="draft" />}
                  </span>
                </td>
                <td class="covered" data-label="Contracts covered">
                  <span class="ratio">
                    <strong>{count(totals.covered)}</strong> of {count(totals.contracts)}
                  </span>
                  <span class="marks" aria-hidden="true">
                    {marks.map((status) => (
                      <StatusIcon status={status} />
                    ))}
                  </span>
                  {totals.partial > 0 && <span class="more">{count(totals.partial)} partial</span>}
                </td>
                <td class="share" data-label="Clear-signable, of recent transactions">
                  {totals.txShareCovered === null ? (
                    <span class="none">No recent transactions</span>
                  ) : (
                    <>
                      <span class="pct">{percent(totals.txShareCovered)}</span>
                      <Meter share={totals.txShareCovered} />
                      <span class="more">
                        {totals.signerShareCovered === null
                          ? "Senders not known"
                          : `${percent(totals.signerShareCovered)} of recent senders`}
                      </span>
                    </>
                  )}
                </td>
                <td class="num" data-label="Transactions a day">
                  {perDay(totals.perDay)}
                </td>
              </tr>
              <tr class="details" id={`protocol-${protocol.id}-contracts`}>
                <td colspan={COLUMNS}>
                  <div class="detail">
                    <p class="detail-head">
                      <span>
                        {protocol.name}: {plural(totals.contracts, "contract")} · {count(totals.covered)} covered,{" "}
                        {count(totals.partial)} partial, {count(totals.uncovered)} uncovered
                        {totals.drafts > 0 && <> · {plural(totals.drafts, "draft")} ready</>}
                      </span>
                      <a href={protocol.website}>{host(protocol.website)}</a>
                    </p>
                    <div class="contracts">
                      {contracts.map((contract) => (
                        <ContractCard contract={contract} />
                      ))}
                    </div>
                  </div>
                </td>
              </tr>
            </tbody>
          ))
        }

        <tbody class="empty" hidden>
          <tr>
            <td colspan={COLUMNS}>No protocol matches these filters.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</Section>

<style>
  .board {
    margin-top: 2.75rem;
  }

  /* ── The filters: shown only when the board's script can run them ── */

  .toolbar {
    display: none;
  }

  [data-js] .toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem 1rem;
    align-items: end;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 40rem) {
    [data-js] .toolbar {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .search,
    .tally {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    [data-js] .toolbar {
      grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    }
    .search {
      grid-column: auto;
    }
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  .field-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .field input,
  .field select {
    width: 100%;
    height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    font: inherit;
    font-size: var(--sl-text-sm);
    color: var(--ink);
  }

  .field select {
    appearance: none;
    padding-inline-end: 2rem;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--ink-muted) 50%),
      linear-gradient(135deg, var(--ink-muted) 50%, transparent 50%);
    background-position:
      calc(100% - 1.05rem) 55%,
      calc(100% - 0.75rem) 55%;
    background-size: 0.3rem 0.3rem;
    background-repeat: no-repeat;
  }

  .field input::placeholder {
    color: var(--sl-color-gray-4);
  }

  .field input:focus-visible,
  .field select:focus-visible {
    border-color: var(--brand);
    outline: 2px solid color-mix(in srgb, var(--brand) 35%, transparent);
    outline-offset: 1px;
  }

  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .shown {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-stretch: 87.5%;
    color: var(--ink-muted);
  }

  .reset {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    cursor: pointer;
  }

  .reset:hover {
    text-decoration: underline;
  }

  /* ── The table ────────────────────────────────────────────────────── */

  .frame {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
    color: var(--ink);
  }

  thead th {
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-align: start;
    text-transform: uppercase;
    vertical-align: bottom;
    color: var(--ink-muted);
  }

  thead th:first-child {
    padding-inline-start: 1.1rem;
  }

  thead th:last-child {
    padding-inline-end: 1.1rem;
  }

  .sub {
    display: block;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--sl-color-gray-4);
  }

  .sort {
    display: inline-flex;
    gap: 0.4rem;
    align-items: flex-end;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-align: inherit;
    text-transform: inherit;
    color: inherit;
  }

  .sort:not(:disabled) {
    cursor: pointer;
  }

  .sort:not(:disabled):hover {
    color: var(--ink);
  }

  .sort:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* The arrow says which column the rows follow, and which way. */
  .arrow {
    width: 0.5rem;
    height: 0.5rem;
    margin-bottom: 0.2rem;
    border-inline-end: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    opacity: 0;
    rotate: 45deg;
  }

  [aria-sort] .arrow {
    opacity: 1;
    color: var(--sl-color-text-accent);
  }

  [aria-sort="ascending"] .arrow {
    margin-bottom: -0.05rem;
    rotate: 225deg;
  }

  [aria-sort] .sort {
    color: var(--ink);
  }

  .num {
    text-align: end;
  }

  thead .num .sort {
    flex-direction: row-reverse;
  }

  /* One protocol: its row and, under it, its contracts. */
  .group + .group,
  .group + .empty {
    border-top: 1px solid var(--line);
  }

  .summary > * {
    padding: 1rem 0.75rem;
    text-align: start;
    vertical-align: top;
  }

  .summary > :first-child {
    padding-inline-start: 1.1rem;
  }

  .summary > :last-child {
    padding-inline-end: 1.1rem;
  }

  .summary > .num {
    text-align: end;
  }

  [data-ready] .summary {
    cursor: pointer;
  }

  [data-ready] .summary:hover {
    background-color: color-mix(in srgb, var(--brand-soft) 22%, transparent);
  }

  .open .summary {
    background-color: color-mix(in srgb, var(--brand-soft) 30%, transparent);
  }

  .rank {
    width: 1%;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--sl-color-gray-4);
    white-space: nowrap;
  }

  td.rank {
    padding-top: 1.25rem;
  }

  .toggle {
    display: inline-flex;
    gap: 0.45rem;
    align-items: flex-start;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: start;
    color: var(--ink);
  }

  .toggle:not(:disabled) {
    cursor: pointer;
  }

  .toggle:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .chevron {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    fill: none;
    stroke: var(--sl-color-text-accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Down when the contracts show: every row without scripts, an open one with them. */
  .board:not([data-js]) .chevron,
  .open .chevron {
    rotate: 90deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chevron {
      transition: rotate 160ms ease;
    }
  }

  .category {
    color: var(--sl-color-gray-2);
  }

  /* Two to a line in the table, so four chains make a block, not a ragged stack. */
  .tags {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .covered {
    min-width: 7rem;
  }

  .share {
    min-width: 10rem;
  }

  .ratio {
    display: block;
    color: var(--ink-muted);
  }

  .ratio strong,
  .pct {
    font-size: 1.05rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    margin-top: 0.35rem;
  }

  .marks :global(.icon) {
    width: 0.8rem;
    height: 0.8rem;
  }

  .more,
  .none {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--sl-text-xs);
    color: var(--ink-muted);
  }

  .share .pct {
    display: block;
  }

  .share :global(.meter) {
    max-width: 9rem;
    margin-top: 0.4rem;
  }

  td.num {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ── A protocol's contracts ───────────────────────────────────────── */

  .details > td {
    padding: 0 1.1rem 1.25rem;
  }

  [data-js] .group:not(.open) .details {
    display: none;
  }

  .detail {
    display: grid;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--line);
  }

  .detail-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    justify-content: space-between;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-stretch: 87.5%;
    color: var(--ink-muted);
  }

  .detail-head a {
    color: var(--sl-color-text-accent);
  }

  .contracts {
    display: grid;
    gap: 1rem;
  }

  .contracts :global(.contract) {
    background-color: var(--surface);
  }

  .empty td {
    padding: 2.5rem 1.1rem;
    color: var(--ink-muted);
    text-align: center;
  }

  /* `hidden` hides a row however the layout below displays it. */
  tbody[hidden] {
    display: none !important;
  }

  /* ── Below 64rem: each protocol is a card ─────────────────────────── */

  @media (max-width: 63.99rem) {
    .frame {
      border: 0;
      background: none;
    }

    table,
    tbody,
    tr,
    td,
    th,
    caption {
      display: block;
    }

    thead {
      display: none;
    }

    .group {
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background-color: var(--surface-raised);
    }

    .group + .group,
    .group + .empty {
      margin-top: 0.75rem;
      border-top: 1px solid var(--line);
    }

    .summary {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.9rem 1rem;
      padding: 1rem 1.1rem 1.1rem;
      border-radius: var(--radius-md);
    }

    .open .summary {
      border-end-start-radius: 0;
      border-end-end-radius: 0;
    }

    .summary > *,
    .summary > :first-child,
    .summary > :last-child {
      padding: 0;
      text-align: start;
    }

    .summary > .num {
      text-align: start;
    }

    td.rank {
      display: none;
    }

    .protocol,
    .status {
      grid-column: 1 / -1;
    }

    .protocol {
      padding-bottom: 0.1rem;
    }

    .toggle {
      font-size: 1.1rem;
    }

    .summary td[data-label]:not(.rank, .status)::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.3rem;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 400;
      letter-spacing: 0.12em;
      line-height: 1.4;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .covered,
    .share {
      min-width: 0;
    }

    .details > td {
      padding: 0 0.75rem 0.75rem;
    }

    .detail {
      padding-top: 0.9rem;
    }

    .contracts :global(.contract) {
      padding: 1rem;
    }
  }
</style>

<script>
  const board = document.querySelector<HTMLElement>("[data-board]");
  if (board) setUp(board);

  function setUp(board: HTMLElement) {
    const form = board.querySelector<HTMLFormElement>(".toolbar");
    const table = board.querySelector<HTMLTableElement>("table");
    const empty = board.querySelector<HTMLElement>("tbody.empty");
    const shown = board.querySelector<HTMLElement>("[data-shown]");
    if (!form || !table || !empty || !shown) return;
    const groups = [...table.querySelectorAll<HTMLElement>("tbody[data-protocol]")];
    const headers = [...table.querySelectorAll<HTMLElement>("th[data-sort]")];

    // ── Opening a protocol ──────────────────────────────────────────────
    const toggleOf = (group: HTMLElement) => group.querySelector<HTMLButtonElement>(".toggle");
    const open = (group: HTMLElement, value: boolean) => {
      group.classList.toggle("open", value);
      toggleOf(group)?.setAttribute("aria-expanded", String(value));
    };
    for (const group of groups) {
      const toggle = toggleOf(group);
      if (!toggle) continue;
      toggle.disabled = false;
      open(group, false);
      toggle.addEventListener("click", () => open(group, !group.classList.contains("open")));
      // The whole row opens it, except its links, and except when text is being selected.
      group.querySelector(".summary")?.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a, button") || String(getSelection() ?? "")) return;
        open(group, !group.classList.contains("open"));
      });
    }

    // A link to #protocol-<id>, or to anything inside one, opens that protocol.
    const follow = () => {
      const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      const group = target?.closest<HTMLElement>("tbody[data-protocol]");
      if (!group) return;
      open(group, true);
      group.hidden = false;
      target?.scrollIntoView();
    };
    window.addEventListener("hashchange", follow);

    // ── Filtering ────────────────────────────────────────────────────────
    const filter = () => {
      const data = new FormData(form);
      const query = String(data.get("q") ?? "")
        .trim()
        .toLowerCase();
      const chain = String(data.get("chain") ?? "");
      const category = String(data.get("category") ?? "");
      const status = String(data.get("status") ?? "");
      let matches = 0;
      for (const group of groups) {
        const { chains = "", search = "" } = group.dataset;
        const match =
          (!query || query.split(/\s+/).every((word) => search.includes(word))) &&
          (!chain || chains.split(" ").includes(chain)) &&
          (!category || group.dataset.category === category) &&
          (!status || (status === "draft" ? "draft" in group.dataset : group.dataset.status === status));
        group.hidden = !match;
        if (match) matches += 1;
      }
      empty.hidden = matches > 0;
      const noun = groups.length === 1 ? "protocol" : "protocols";
      shown.textContent = matches === groups.length ? `All ${groups.length} ${noun}` : `${matches} of ${groups.length} ${noun}`;
    };
    form.addEventListener("input", filter);
    form.addEventListener("submit", (event) => event.preventDefault());
    // The fields take their first values only after the reset event.
    form.addEventListener("reset", () => setTimeout(filter));

    // ── Sorting ──────────────────────────────────────────────────────────
    let key = "perDay";
    let descending = true;
    const valueOf = (group: HTMLElement): string | number => {
      if (key === "name") return group.dataset.name ?? "";
      const value = group.dataset[key];
      return value ? Number(value) : Number.NaN;
    };
    const sort = () => {
      const sign = descending ? -1 : 1;
      groups.sort((a, b) => {
        const [x, y] = [valueOf(a), valueOf(b)];
        // A protocol with nothing to compare goes last, either way round.
        if (typeof x === "number" && typeof y === "number" && Number.isNaN(x) !== Number.isNaN(y))
          return Number.isNaN(x) ? 1 : -1;
        const order = typeof x === "string" ? x.localeCompare(String(y)) : x - Number(y);
        return sign * order || Number(a.dataset.rank) - Number(b.dataset.rank);
      });
      empty.before(...groups);
      for (const header of headers)
        if (header.dataset.sort === key) header.setAttribute("aria-sort", descending ? "descending" : "ascending");
        else header.removeAttribute("aria-sort");
    };
    for (const header of headers) {
      const button = header.querySelector("button");
      if (!button) continue;
      button.disabled = false;
      button.addEventListener("click", () => {
        const next = header.dataset.sort ?? "perDay";
        // A new column starts from its most telling end: names from A, numbers from the most.
        descending = next === key ? !descending : next !== "name";
        key = next;
        sort();
      });
    }

    board.dataset.ready = "";
    filter();
    follow();
  }
</script>

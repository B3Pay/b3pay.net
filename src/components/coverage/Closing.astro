---
/**
 * FIG. 05: the way in, on the home page's closing band: the hairline grid
 * on the raised surface, full width, without the wall of calldata.
 */
import { LinkButton } from "@astrojs/starlight/components";
import Section from "../home/Section.astro";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="closing">
  <div class="band" aria-hidden="true"></div>
  <Section {id} fig="FIG. 05" eyebrow="Get covered" title="Is your protocol missing or partly covered?">
    <Fragment slot="lead">
      <p>
        We write, test and submit descriptors. Tell us the chains, the addresses and the flows your users sign. Where this
        page shows a draft ready for one of your contracts, the full draft is on request.
      </p>
    </Fragment>
    <div class="actions rise">
      <LinkButton href="/clear-signing/#start" icon="right-arrow">Start with your contracts</LinkButton>
      <LinkButton href="/clear-signing/" variant="minimal">What we do for a protocol</LinkButton>
    </div>
  </Section>
</div>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    margin-top: clamp(5rem, 4rem + 6vw, 9rem);
    padding-block: clamp(3.5rem, 2.5rem + 5vw, 6.5rem);
  }

  .closing :global(.home-section) {
    margin-top: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    margin-top: 2.25rem;
  }

  /* Full width, behind the copy. */
  .band {
    position: absolute;
    z-index: -1;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    translate: -50% 0;
    border-block: 1px solid var(--line);
    background-color: var(--surface-raised);
    background-image: linear-gradient(90deg, color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%;
  }

  @media (max-width: 48rem) {
    .band {
      background-size: calc(100% / 6) 100%;
    }
  }
</style>

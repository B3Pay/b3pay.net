---
/**
 * The way in, on the home page's closing band: the hairline grid on the
 * raised surface, full width, without the wall of calldata. The overview
 * and each protocol's page give it their own title and words; the default
 * slot is the lead.
 */
import { LinkButton } from "@astrojs/starlight/components";
import Section from "../home/Section.astro";

interface Props {
  id: string;
  fig: string;
  title: string;
  /** The second way out: by default, what B3Pay does for a protocol. */
  back?: { href: string; text: string };
}

const { id, fig, title, back = { href: "/clear-signing/", text: "What we do for a protocol" } } = Astro.props;
---

<div class="closing">
  <div class="band" aria-hidden="true"></div>
  <Section {id} {fig} eyebrow="Get covered" {title}>
    <Fragment slot="lead"><slot /></Fragment>
    <div class="actions rise">
      <LinkButton href="/clear-signing/#start" icon="right-arrow">Start with your contracts</LinkButton>
      <LinkButton href={back.href} variant="minimal">{back.text}</LinkButton>
    </div>
  </Section>
</div>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    margin-top: clamp(5rem, 4rem + 6vw, 9rem);
    padding-block: clamp(3.5rem, 2.5rem + 5vw, 6.5rem);
  }

  .closing :global(.home-section) {
    margin-top: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    margin-top: 2.25rem;
  }

  /* Full width, behind the copy. */
  .band {
    position: absolute;
    z-index: -1;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    translate: -50% 0;
    border-block: 1px solid var(--line);
    background-color: var(--surface-raised);
    background-image: linear-gradient(90deg, color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%;
  }

  @media (max-width: 48rem) {
    .band {
      background-size: calc(100% / 6) 100%;
    }
  }
</style>

{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/ic/**",
              "components/navigation/**",
              "components/overlay/**",
              "ui_kits/docs/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Inter|JetBrains Mono|Instrument Serif))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Inter, JetBrains Mono, Instrument Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|title|icon|action|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: color, title, icon, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|size|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, color, size, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|filled|outlined)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'filled' | 'outlined'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md)$/]",
        "message": "<Badge> size must be one of 'xs' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Box'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|padding|gap|direction|align|justify|bg|border|radius|key|ref|className|style|children)$/]",
        "message": "<Box> doesn't accept that prop. Declared props: as, padding, gap, direction, align, justify, bg, border, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='Box'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:row|column)$/]",
        "message": "<Box> direction must be one of 'row' | 'column'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Box'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:flex-start|center|flex-end|stretch)$/]",
        "message": "<Box> align must be one of 'flex-start' | 'center' | 'flex-end' | 'stretch'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Box'] > JSXAttribute[name.name='justify'] > Literal[value!=/^(?:flex-start|center|flex-end|space-between)$/]",
        "message": "<Box> justify must be one of 'flex-start' | 'center' | 'flex-end' | 'space-between'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Box'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:xs|sm|md|lg|xl|2xl|full)$/]",
        "message": "<Box> radius must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|wordmark|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: variant, tone, size, wordmark."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:horizontal|stacked|mark)$/]",
        "message": "<BrandMark> variant must be one of 'horizontal' | 'stacked' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onDark|onLight|forge|current)$/]",
        "message": "<BrandMark> tone must be one of 'onDark' | 'onLight' | 'forge' | 'current'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|size|icon|iconRight|isActive|isLoading|asIconButton|fullWidth|bevel|as|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, color, size, icon, iconRight, isActive, isLoading, asIconButton, fullWidth, bevel, as."
      },

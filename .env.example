# Contact form delivery (api/contact.ts). Set these in Vercel > Settings >
# Environment Variables. Without all three the endpoint returns 503 and the
# form reports the failure — it never silently discards a submission.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=hello@b3pay.net
CONTACT_FROM_EMAIL=B3Pay site <site@b3pay.net>
